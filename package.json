{
  "name": "vgpu-video-fx",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @vgpu-fx/web",
    "build": "npm run build -w @vgpu-fx/web",
    "preview": "npm run preview -w @vgpu-fx/web",
    "check:shaders": "node scripts/check-shaders.mjs",
    "smoke": "node scripts/smoke.mjs",
    "check:video-wait": "node scripts/check-video-wait.mjs",
    "check:frames": "node scripts/check-frames.mjs",
    "export:effects": "node scripts/export-effects.mjs",
    "typecheck": "tsc -p packages/effect-core && tsc -p packages/web",
    "sidecar": "npm run start -w @vgpu-fx/sidecar",
    "build:effect-rs:wasm": "wasm-pack build effect-rs --release --target web --out-dir pkg -- --no-default-features --features wasm",
    "build:effect-rs:py": "cd bmf-demo && uvx maturin build --release -m ../effect-rs/Cargo.toml && uv pip install --reinstall effect-rs/target/wheels/effect_rs-*.whl",
    "test:effect-rs": "cargo test --manifest-path effect-rs/Cargo.toml",
    "smoke:sidecar": "node scripts/smoke-sidecar.mjs",
    "test": "npx vgpu doctor && npm run check:shaders && npm run smoke && npm run check:regressions && npm run smoke:sidecar && npm run check:frames && npm run check:video-wait && npm run typecheck",
    "check:regressions": "node scripts/check-effect-regressions.mjs",
    "check:ae-parity": "node scripts/check-ae-parity.mjs"
  },
  "dependencies": {
    "vgpu": "^0.4.0"
  },
  "devDependencies": {
    "@webgpu/types": "^0.1.72",
    "typescript": "^5.9.2",
    "vite": "^8.2.2"
  },
  "allowScripts": {
    "@vgpu/adapter-node@0.4.0": true,
    "webgpu@0.4.0": true
  }
}
